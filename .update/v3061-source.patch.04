+    const direction = this.active === 0 ? 1 : -1;
+    ctx.save();
+    ctx.strokeStyle = 'rgba(220,245,255,0.18)';
+    ctx.setLineDash([10, 10]);
+    ctx.beginPath();
+    ctx.moveTo(this.planets()[0].position.x + this.planetRadius() * 1.4, shuttle.position.y);
