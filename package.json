{
  "name": "ciencia-em-movimento",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma modular de experiências científicas controladas por gestos, com seis jogos, duelo para dois jogadores, menu seguro e ranking global.",
  "scripts": {
    "assemble": "node scripts/assemble-duel.mjs",
    "dev": "npm run assemble && vite --host 0.0.0.0",
    "setup": "node scripts/setup-assets.mjs && node scripts/assemble-duel.mjs",
    "postinstall": "npm run setup",
    "build": "node scripts/build.mjs",
    "check": "npm run assemble && tsc --noEmit && npm run build",
    "kiosk": "node scripts/kiosk.mjs",
    "serve": "node scripts/static-server.mjs",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@mediapipe/hands": "0.4.1675469240"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
